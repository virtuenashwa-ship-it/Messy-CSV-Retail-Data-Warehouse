import logging
import sqlite3
import sys
from pathlib import Path
import pandas as pd

sys.path.append(str(Path(__file__).resolve().parent.parent))

from config.settings import DB_PATH
from src.extract import load_raw_csvs
from src.load import load_warehouse
from src.transform import transform_retail_data

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
    handlers=[logging.StreamHandler(), logging.FileHandler("retail_warehouse.log")],
)
logger = logging.getLogger(__name__)


def run() -> None:
    logger.info("=== Starting Messy CSV Retail Data Warehouse Pipeline ===")
    try:
        raw_df = load_raw_csvs()
        tables = transform_retail_data(raw_df)
        load_warehouse(tables)

        with sqlite3.connect(DB_PATH) as conn:
            summary = pd.read_sql_query("SELECT * FROM vw_daily_category_sales", conn)

        print("\n--- Daily Category & Region Sales (ZAR) ---")
        print(summary.to_string(index=False))
        print("-------------------------------------------\n")
        logger.info("=== Pipeline Finished Successfully ===")
    except Exception as exc:
        logger.error("Pipeline failed: %s", exc)


if __name__ == "__main__":
    run()
